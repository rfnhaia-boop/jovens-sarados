{
  "name": "jovens-sarados",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@js/web",
    "dev:api": "turbo dev --filter=@js/api",
    "db:push": "pnpm --filter @js/api exec prisma db push",
    "db:studio": "pnpm --filter @js/api exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  },
  "packageManager": "pnpm@10.27.0"
}
